# Supabase Configuration (Public anon/publishable keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production Backend API URL
# Leave blank for local development (Vite dev proxy forwards /api to http://127.0.0.1:8000)
# Set to your deployed Django domain when hosting frontend and backend separately:
VITE_API_URL=
