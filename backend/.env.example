# Django Security & Host Settings
DJANGO_SECRET_KEY=your-secure-django-secret-key-min-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Supabase Auth & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# External Data & AI Integrations
EODHD_API_KEY=your-eodhd-api-token
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key

# Internal Webhook / Background Trigger Security
CRON_SECRET=your-custom-cron-secret
